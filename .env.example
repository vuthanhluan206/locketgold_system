# MongoDB connection URI (Use MongoDB Atlas mongodb+srv://... on VPS to save RAM)
# Legacy alias MONGO_URI is also supported for backward compatibility.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=locket_manager

# NextDNS Configuration ID (6 hex characters)
NEXTDNS_ID=a8b247

# Optional Lab Root CA public certificate (provide only ONE of ROOT_CA_PATH or ROOT_CA_PEM; never include private key)
# Leave both empty in production for a DNS-only mobileconfig profile.
ROOT_CA_PATH=
ROOT_CA_PEM=

# Superadmin account (run `python -m app.bootstrap` to generate PBKDF2-SHA256 hash)
# Legacy aliases ADMIN_EMAIL and ADMIN_PASSWORD_HASH are also supported (if both are set, they must match).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD_HASH=
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=

# Custom path for the admin login page
ADMIN_PATH=/admin

# Explicit hostnames allowed (JSON array or comma-separated hostnames; no wildcards)
ALLOWED_HOSTS=["locketgold.vuthanhluan.bond","localhost","127.0.0.1","[::1]"]
LAB_DOMAIN=locketgold.vuthanhluan.bond
LAB_SCOPED_DOMAINS=["mock.lab.vuthanhluan.bond","sub.lab.vuthanhluan.bond","locketgold.vuthanhluan.bond"]

REQUIRE_HTTPS=true
SESSION_TTL_SECONDS=3600

# Research Proxy feature flag (MUST remain false in production; only enable in isolated local lab with mock upstream)
ENABLE_RESEARCH_PROXY=false
RESEARCH_PROXY_UPSTREAM=http://127.0.0.1:8081

# Optional Cloudflare Turnstile configuration for admin login
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=locketgold.vuthanhluan.bond

# Trusted reverse proxy CIDRs (e.g. Docker internal bridge ["172.16.0.0/12"] when behind local Caddy; never use 0.0.0.0/0)
TRUSTED_PROXY_CIDRS=[]

# Optional 32-256 character ASCII token for server-to-server subscriber checks
# SUBSCRIBER_API_TOKEN=
