# ==============================================================================
# STAGING ENVIRONMENT CONFIGURATION (`.env.staging.example`)
# Copy to `.env.staging` before running `compose.staging.yaml`:
#   cp .env.staging.example .env.staging
# ==============================================================================

# 1. Execution Mode (MUST be 'staging'; prevents accidental use of production database `locket_manager`)
APP_ENV=staging

# 2. Isolated Staging MongoDB Connection & Database
# Recommendation: Create a dedicated MongoDB Atlas user with readWrite privileges ONLY on `locket_manager_staging`.
# NEVER set MONGODB_DATABASE=locket_manager in staging (startup and preflight will refuse to run!).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=locket_manager_staging

# 3. NextDNS Configuration ID (Mode A: 6 hex characters) & Custom DoH Lab URL (Mode B)
# LAB_MODE='local' allows 127.0.0.1 for local Docker E2E tests.
# LAB_MODE='real_device' REQUIRES a publicly reachable IPv4 (e.g. 103.118.29.159) so a real iPhone never resolves lab domains to 127.0.0.1!
NEXTDNS_ID=a8b247
DOH_SERVER_URL=
LAB_MODE=local
LAB_DNS_TARGET_IP=127.0.0.1
LAB_DNS_TARGET_IPV6=

# 4. Optional Lab Root CA Public Certificate (Mounted read-only at /app/certs_public/lab_root_ca.pem)
# Leave empty for Mode A (Core Staging DNS-only). Set to `/app/certs_public/lab_root_ca.pem` for Mode B (HTTPS Research Lab).
ROOT_CA_PATH=
ROOT_CA_PEM=

# 5. Superadmin Account for Staging (run `python -m app.bootstrap` to generate PBKDF2-SHA256 hash)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD_HASH=

# 6. Admin Login Route
ADMIN_PATH=/admin

# 7. Allowed Hostnames & Controlled Research Lab Domains
ALLOWED_HOSTS=["locketgold.vuthanhluan.bond","mock.lab.vuthanhluan.bond","sub.lab.vuthanhluan.bond","localhost","127.0.0.1","[::1]"]
LAB_DOMAIN=locketgold.vuthanhluan.bond
LAB_SCOPED_DOMAINS=["mock.lab.vuthanhluan.bond","sub.lab.vuthanhluan.bond","locketgold.vuthanhluan.bond"]

# 8. HTTP / HTTPS & Reverse Proxy Policy
# Mode A (Core Staging on loopback 127.0.0.1:18000 / SSH tunnel): REQUIRE_HTTPS=false, TRUSTED_PROXY_CIDRS=[]
# Mode B (Behind Caddy HTTPS Lab on 127.0.0.1:18443): Set REQUIRE_HTTPS=true and set TRUSTED_PROXY_CIDRS to the exact Caddy container IP/32.
REQUIRE_HTTPS=false
TRUSTED_PROXY_CIDRS=[]
SESSION_TTL_SECONDS=3600

# 9. Research Proxy Feature Flag (Keep false unless testing isolated local mock upstream)
ENABLE_RESEARCH_PROXY=false
RESEARCH_PROXY_UPSTREAM=http://127.0.0.1:8081

# 10. Optional Cloudflare Turnstile (Leave blank for local/loopback Staging smoke tests)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=locketgold.vuthanhluan.bond

# 11. Optional Server-to-Server Subscriber API Token (32-256 ASCII chars)
# SUBSCRIBER_API_TOKEN=

# 12. Internal Gold Grant Policy for Public-Derived UIDs (`admin_authorized_public_uid`)
ALLOW_ADMIN_PUBLIC_UID_GRANT=true
